# Copy to .env and adjust. Defaults work with `npm run db`.
PORT=3003
DATABASE_URL=postgres://postgres:postgres@localhost:5543/encore
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Refunds close this many hours before the event starts.
REFUND_CUTOFF_HOURS=24
# How often the server releases seats from expired holds.
HOLD_SWEEP_SECONDS=30
